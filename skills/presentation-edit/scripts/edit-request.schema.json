{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expectedDestinationSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        },
        {
          "enum": [
            "null"
          ]
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "minimum": 1
          },
          "target": {
            "type": "object",
            "properties": {
              "shapePath": {
                "type": "array",
                "minItems": 1,
                "maxItems": 65,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "order": {
                "const": "top_to_bottom"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "shapePath"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "order"
                      ]
                    },
                    {
                      "required": [
                        "ordinal"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "order",
                  "ordinal"
                ],
                "not": {
                  "required": [
                    "shapePath"
                  ]
                }
              }
            ]
          },
          "alignment": {
            "enum": [
              "left",
              "center",
              "right",
              "justify"
            ]
          },
          "color": {
            "type": "object",
            "properties": {
              "rgb": {
                "type": "string",
                "pattern": "^#?[a-fA-F0-9]{6}$",
                "description": "Use for a user-specified RGB value."
              },
              "editor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "palette": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Requested color name in the read document's editorPalette; no RGB guessing."
              }
            },
            "required": [],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "rgb"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "editor"
                      ]
                    },
                    {
                      "required": [
                        "palette"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "editor",
                  "palette",
                  "name"
                ],
                "not": {
                  "required": [
                    "rgb"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "slide",
          "target"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "alignment"
            ]
          },
          {
            "required": [
              "color"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "path",
    "expectedSha256",
    "destination",
    "expectedDestinationSha256",
    "operations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
