<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#0d1117">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="40dp" android:layout_height="57dp"
            android:src="@drawable/ic_roami_mark" android:contentDescription="@string/app_name" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:text="@string/pick_title"
            android:textColor="#e6edf3" android:textSize="28sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/pick_sub" android:textColor="#8b949e" android:textSize="15sp" />
    <TextView android:id="@+id/auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:textColor="#8b949e" android:textSize="15sp" />
    <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <EditText android:id="@+id/url" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
            android:hint="@string/pick_hint" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true"
            android:textColor="#e6edf3" android:textColorHint="#484f58" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/bg_card" />
        <TextView android:id="@+id/go" android:gravity="center" android:textSize="16sp" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="10dp"
            android:text="@string/pick_go" android:textColor="#e6edf3" android:background="@drawable/bg_card" android:paddingStart="20dp" android:paddingEnd="20dp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="@string/pick_help" android:textColor="#8b949e" android:textSize="14sp" android:lineSpacingExtra="4dp" />
    <TextView android:id="@+id/ver" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:textColor="#484f58" android:textSize="12sp" />
</LinearLayout>
