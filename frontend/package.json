{
  "name": "ttmux-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run hover:check && NODE_OPTIONS=--max-old-space-size=6144 vite build && node scripts/compress-dist.mjs",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "hover:check": "node scripts/hover-scope-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "design:capabilities": "node scripts/build-capability-design.mjs"
  },
  "dependencies": {
    "@jvmr/pptx-to-html": "^1.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.21.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "echarts": "^6.1.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
