{
  "name": "ttmux-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run hover:check && NODE_OPTIONS=--max-old-space-size=6144 vite build && node scripts/compress-dist.mjs",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "hover:check": "node scripts/hover-scope-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "design:capabilities": "node scripts/build-capability-design.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^16.6.0",
    "@jvmr/pptx-to-html": "^1.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.21.6",
    "docx-preview": "^0.3.7",
    "echarts": "^6.1.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
