    "冻结源码及输入hash；未测和未知不能计通过"
  ],
  "hard_assertions": [
    {
      "id": "TASK-NEW01-H1",
      "rule": "每轮任务数量、身份、revision、要求及附件匹配冻结合同，不误建、不丢失、不串任务。",
      "failure_effect": "case_failed"
    },
    {
      "id": "TASK-NEW01-H2",
      "rule": "未来轮输入和宿主expect/fixture脚本不进入真实模型请求；需澄清时不猜目标，重复请求不重复创建。",
      "failure_effect": "case_failed"
    },
    {
      "id": "TASK-NEW01-H3",
      "rule": "机制夹具通过不等于真实模型语义通过；真实模型沿保存配置计量，未知调用不重放。",
      "failure_effect": "case_failed"
    }
  ],
  "decision_domains": [
