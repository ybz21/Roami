{
  "id": "MECH-TC01",
  "kind": "mechanism_regression",
  "category": "MECH",
  "category_label": "原任务续作的附图来源与恢复说明",
  "prompt": "验证旧审计副本缺图时沿真实来源恢复，连续续作保留输入与原执行器，版本冲突和未知结果给出正确恢复边界。",
  "preconditions": "隔离临时SQLite、ArtifactStore与私有tmux实例；脚本化模型/CLI、本地进程和公开合成图文；无生产读写。",
  "expected_terminal": "complete_source_frozen_task_recovery_receipts",
  "counts_as_delivery": false,
  "selected_in_mixed_suite_v1": false,
  "run_profile": "isolated_host_regression",
  "required_deliverables": [
    "输入清单、源代码和回归用例SHA256快照",
    "零跳过且身份完全匹配的测试回执与原始输出",
    "隔离实例清理与源码前后未变证明"
  ],
  "hard_assertions": [
    {
      "id": "MECH-TC01-H1",
      "rule": "连续纯文字续作保留本任务原图和后来附图；不扫描其他Main请求，不重放旧完整指令。",
      "failure_effect": "case_failed"
    },
    {
      "id": "MECH-TC01-H2",
      "rule": "旧operationId回执能证明来源时才恢复缺失附件；源消息或图片撤回在revision推进前阻断。",
      "failure_effect": "case_failed"
    },
    {
      "id": "MECH-TC01-H3",
      "rule": "保留原task、provider、session和workspace；stale revision、pending、失效session及未知结果不能新建替代任务或盲重放。",
      "failure_effect": "case_failed"
    },
    {
      "id": "MECH-TC01-H4",
      "rule": "明确stopConfirmed不等于outcomeKnown；正确拒绝和恢复说明持久化，完成回调不能自行发起续作。",
      "failure_effect": "case_failed"
    }
  ],
